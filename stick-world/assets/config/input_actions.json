{
	"domains": [
		{ "id": "possess", "title": "附身", "color": "lake" },
		{ "id": "world", "title": "世界", "color": "grass" },
		{ "id": "common", "title": "通用", "color": "amber" },
		{ "id": "command", "title": "指挥", "color": "brick" },
		{ "id": "strategy", "title": "战略图", "color": "sky_blue" },
		{ "id": "debug", "title": "调试", "color": "stone" }
	],
	"actions": [
		{ "action": "possess/move_up", "domain": "possess", "label": "移动", "note": "附身时驱动实体",
			"binds": [ { "physical": "W" }, { "physical": "UP" } ] },
		{ "action": "possess/move_down", "domain": "possess", "label": "移动", "note": "附身时驱动实体",
			"binds": [ { "physical": "S" }, { "physical": "DOWN" } ] },
		{ "action": "possess/move_left", "domain": "possess", "label": "移动", "note": "附身时驱动实体",
			"binds": [ { "physical": "A" }, { "physical": "LEFT" } ] },
		{ "action": "possess/move_right", "domain": "possess", "label": "移动", "note": "附身时驱动实体",
			"binds": [ { "physical": "D" }, { "physical": "RIGHT" } ] },
		{ "action": "possess/toggle_combat", "domain": "possess", "label": "战斗", "note": "建造/战斗模式切换",
			"binds": [ { "physical": "Q" } ] },
		{ "action": "possess/toggle_walk_run", "domain": "possess", "label": "奔跑", "note": "散步/奔跑切换",
			"binds": [ { "physical": "ALT" } ] },
		{ "action": "possess/swing", "domain": "possess", "label": "空挥", "note": "无目标攻击动作",
			"binds": [ { "physical": "G" } ] },
		{ "action": "possess/interact", "domain": "possess", "label": "交互", "note": "取放材料/敲击建造；按住连采",
			"binds": [ { "physical": "F" } ] },
		{ "action": "possess/escape_stuck", "domain": "possess", "label": "脱困", "note": "脱离卡死",
			"binds": [ { "physical": "H" } ] },
		{ "action": "possess/attack", "domain": "possess", "label": "攻击", "note": "挥砍攻击（鼠标不在 UI 上时）",
			"binds": [ { "mouse": "LEFT" } ] },
		{ "action": "possess/block", "domain": "possess", "label": "举盾", "note": "按住举盾、松开放下",
			"binds": [ { "mouse": "RIGHT" } ] },

		{ "action": "world/open_inventory", "domain": "world", "label": "背包", "note": "开/关背包（模态）",
			"binds": [ { "physical": "E" } ] },
		{ "action": "world/panel_tech", "domain": "world", "label": "科技树", "note": "功能占位面板",
			"binds": [ { "physical": "K" } ] },
		{ "action": "world/panel_empire", "domain": "world", "label": "帝国", "note": "帝国概览（占位面板）",
			"binds": [ { "physical": "O" } ] },
		{ "action": "world/panel_collection", "domain": "world", "label": "图鉴", "note": "收藏图鉴（占位面板）",
			"binds": [ { "physical": "J" } ] },
		{ "action": "world/panel_logistics", "domain": "world", "label": "后勤", "note": "功能占位面板",
			"binds": [ { "physical": "L" } ] },
		{ "action": "world/hotbar_1", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 1",
			"binds": [ { "physical": "1" } ] },
		{ "action": "world/hotbar_2", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 2",
			"binds": [ { "physical": "2" } ] },
		{ "action": "world/hotbar_3", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 3",
			"binds": [ { "physical": "3" } ] },
		{ "action": "world/hotbar_4", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 4",
			"binds": [ { "physical": "4" } ] },
		{ "action": "world/hotbar_5", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 5",
			"binds": [ { "physical": "5" } ] },
		{ "action": "world/hotbar_6", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 6",
			"binds": [ { "physical": "6" } ] },
		{ "action": "world/hotbar_7", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 7",
			"binds": [ { "physical": "7" } ] },
		{ "action": "world/hotbar_8", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 8",
			"binds": [ { "physical": "8" } ] },
		{ "action": "world/hotbar_9", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 9",
			"binds": [ { "physical": "9" } ] },
		{ "action": "world/hotbar_0", "domain": "world", "label": "物品", "note": "使用快捷栏物品格 10",
			"binds": [ { "physical": "0" } ] },
		{ "action": "world/zoom_in", "domain": "world", "label": "缩放＋", "note": "镜头拉近",
			"binds": [ { "mouse": "WHEEL_UP" } ] },
		{ "action": "world/zoom_out", "domain": "world", "label": "缩放－", "note": "镜头拉远",
			"binds": [ { "mouse": "WHEEL_DOWN" } ] },
		{ "action": "world/pan", "domain": "world", "label": "平移", "note": "按住中键拖拽平移镜头",
			"binds": [ { "mouse": "MIDDLE" } ] },
		{ "action": "world/drag", "domain": "world", "label": "拖移", "note": "空地按住左键拖拽平移（未被选择/建造消费时）",
			"binds": [ { "mouse": "LEFT" } ] },

		{ "action": "common/toggle_pause", "domain": "common", "label": "暂停", "note": "暂停/继续（仅世界层）",
			"binds": [ { "physical": "SPACE" } ] },
		{ "action": "common/quick_save", "domain": "common", "label": "快存", "note": "快速保存到槽位 0",
			"binds": [ { "key": "F5" } ] },
		{ "action": "common/quick_load", "domain": "common", "label": "快读", "note": "快速读取槽位 0",
			"binds": [ { "key": "F9" } ] },
		{ "action": "common/save_panel", "domain": "common", "label": "存档", "note": "Ctrl+S 开/关存档面板",
			"binds": [ { "key": "S", "mods": [ "CTRL" ] } ] },
		{ "action": "common/toggle_world_map", "domain": "common", "label": "战略图", "note": "打开/返回战略图",
			"binds": [ { "physical": "TAB" } ] },
		{ "action": "common/toggle_strategic_map", "domain": "common", "label": "大世界", "note": "L3 大世界战略图开关",
			"binds": [ { "physical": "M" } ] },

		{ "action": "command/select", "domain": "command", "label": "框选", "note": "拖拽框选单位（指挥态）",
			"binds": [ { "mouse": "LEFT" } ] },
		{ "action": "command/clear", "domain": "command", "label": "清除", "note": "右键清空选择（指挥态）",
			"binds": [ { "mouse": "RIGHT" } ] },

		{ "action": "strategy/mode_terrain", "domain": "strategy", "label": "地形", "note": "战略图模式：地形",
			"binds": [ { "physical": "1" }, { "physical": "KP_1" } ] },
		{ "action": "strategy/mode_political", "domain": "strategy", "label": "政治", "note": "战略图模式：政治",
			"binds": [ { "physical": "2" }, { "physical": "KP_2" } ] },
		{ "action": "strategy/mode_traffic", "domain": "strategy", "label": "交通", "note": "战略图模式：交通",
			"binds": [ { "physical": "3" }, { "physical": "KP_3" } ] },
		{ "action": "strategy/toggle_detail", "domain": "strategy", "label": "细分", "note": "L1/城市预览切换",
			"binds": [ { "physical": "N" } ] },
		{ "action": "strategy/select", "domain": "strategy", "label": "下钻", "note": "点击地块下钻/选中",
			"binds": [ { "mouse": "LEFT" } ] },
		{ "action": "strategy/zoom_in", "domain": "strategy", "label": "缩放＋", "note": "战略图镜头拉近",
			"binds": [ { "mouse": "WHEEL_UP" } ] },
		{ "action": "strategy/zoom_out", "domain": "strategy", "label": "缩放－", "note": "战略图镜头拉远",
			"binds": [ { "mouse": "WHEEL_DOWN" } ] },
		{ "action": "strategy/pan", "domain": "strategy", "label": "平移", "note": "战略图镜头平移",
			"binds": [ { "mouse": "MIDDLE" } ] },

		{ "action": "debug/toggle_overlay", "domain": "debug", "label": "调试层", "note": "调试覆盖层开关",
			"binds": [ { "key": "F3" } ] },
		{ "action": "debug/hot_reload", "domain": "debug", "label": "热重载", "note": "重扫 config 平衡数值",
			"binds": [ { "key": "F9" } ] }
	]
}
