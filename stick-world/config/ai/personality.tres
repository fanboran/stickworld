[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/balance/balance_resource.gd" id="1"]

[resource]
script = ExtResource("1")
resource_name = "personality"
_meta = {
	"resource_name": "personality",
	"version": "0.3.0",
	"description": "AI personality 单一参数档案（A1 · C1/C2 + A2 · C3/C4/C5 + A3 · C6 + A4 · C7，设计文档12号）。手写平衡资源（非 Excel 导出管线背书），BalanceConfig 统一装载（类型路径 ai.personality）与热重载。单一 global 行 = L4 层基础节拍 + 任务槽内核参数（C3 槽超时 / C4 四因子评分权重，CoH 真值）+ 行为机制参数（开局门禁/攻击百分比/方差/撤退掷骰，取原代码默认档案数值 = 零行为变化）+ default_behavior v2 效用打分参数（C7：default_behavior_v2_enabled 开关默认关 = 零回归门，demand_increment=±分基准 CoH 50，方差扰动单旋钮 demand_variance）。难度分档维度（easy/standard/hard/hardest）已裁决移除（开放问题#3）：机制参数保留，无难度差异化。全部数值语义推断初值，待实测校准。",
	"category": "ai"
}
variables = {
	"data": [
		{
			"id": "global",
			"beat_interval": 0.5,
			"slot_kernel_enabled": true,
			"score_threat": 5.0,
			"score_avoid_clumps_at_no_threat": 10.0,
			"score_distance_to_squad": 5.0,
			"score_distance_to_base": 5.0,
			"score_inertia": 1.4,
			"score_threat_radius": 260.0,
			"score_clump_radius": 300.0,
			"score_distance_norm": 1200.0,
			"score_inertia_tolerance": 120.0,
			"attack_rally_timeout": 180.0,
			"attack_target_timeout": 30.0,
			"defend_target_timeout": 120.0,
			"defend_rally_timeout": 240.0,
			"base_threat_threshold": 5.0,
			"base_threat_floor": 5.0,
			"vp_rule_enabled": false,
			"default_behavior_v2_enabled": false,
			"demand_increment": 50.0,
			"seconds_before_attack": 10.0,
			"start_attack_variance": 2.0,
			"demand_variance": 0.8,
			"attack_pct_baseline": 0.6,
			"attack_pct_growth_per_min": 0.01,
			"max_attack_percentage": 0.70,
			"superiority_ratio_floor": 0.4,
			"superiority_gain": 1.0,
			"retreat_chance": 0.30,
			"description": "L4 阵营 AI 全局行（单一参数档案，难度分档维度已裁决移除·开放问题#3）：beat_interval=C1 基础节拍（CoH 0.5s 真值）；slot_kernel_enabled=决策内核开关（false 退化 SWL 比例条件，咬合③）；score_* = C4 目标评分四因子权重（CoH 真值 5/10/5/5/1.4）与取数半径/归一尺度；attack/defend_*_timeout = C3 槽集结/目标超时（CoH 3min/30s/2min）；seconds_before_attack/start_attack_variance=开局攻击门禁基准 ± 掷骰半宽（CoH 9min±4min 同构）；attack_pct_baseline/attack_pct_growth_per_min/max_attack_percentage=C5 攻击百分比基调/递增/封顶（单一参数曲线，0.6/+0.01每分/0.70）；superiority_ratio_floor/superiority_gain=C5 军力优势递增起点/增益（0.4/1.0）；base_threat_*=C5 基地威胁封顶（0-100 口径，CoH 5/5）；retreat_chance=A3 撤退掷骰概率（L1 个体层消费，ai.behavior_profiles 档案基线兜底；CoH 0.30）；vp_rule_enabled=C5 规则一胜利目标危急（开放问题#1 无 VP 等价物，缺省关闭【提案/待定】）；default_behavior_v2_enabled=C7 效用打分选择器开关（消费组织 default_behavior 字段，缺省关闭=零回归门）；demand_increment=C7 ±分基准（命中 +N 未命中 -N，CoH s_demand_increment=50 真值）；demand_variance=C7 方差扰动单旋钮（收敛红线·咬合④）"
		}
	]
}
