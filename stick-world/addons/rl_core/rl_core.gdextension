[libraries]

windows.debug.x86_64 = "res://addons/rl_core/bin/librl_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/rl_core/bin/librl_core.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/rl_core/bin/librl_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/rl_core/bin/librl_core.linux.template_release.x86_64.so"
macos.debug = "res://addons/rl_core/bin/librl_core.macos.template_debug.framework"
macos.release = "res://addons/rl_core/bin/librl_core.macos.template_release.framework"
