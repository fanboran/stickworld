## 大面板圆角（更圆润，磨砂质感）
const RADIUS_PANEL := 10
## 描边宽度
const BORDER_W := 1
## 控件内边距（左右）
const PAD_X := 12
## 控件内边距（上下）
const PAD_Y := 6
