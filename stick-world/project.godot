; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="火柴人帝国模拟"
run/main_scene="res://modules/ui_global/scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/autoload/event_bus.gd"
WorldState="*res://core/autoload/world_state.gd"
ConfigManager="*res://core/autoload/config_manager.gd"
TimeManager="*res://core/autoload/time_manager.gd"
BalanceConfig="*res://core/autoload/balance_config.gd"
InputBindings="*res://core/autoload/input_bindings.gd"
AudioManager="*res://core/services/audio_manager.gd"
MusicDirector="*res://core/services/music_director.gd"
SaveManager="*res://core/autoload/save_manager.gd"
DebugApi="*res://modules/debug_gui/api.gd"
DevSceneEscape="*res://modules/debug_gui/scripts/dev_scene_escape.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/map_editor/plugin.cfg")

[file_customization]

folder_colors={
"res://modules/": "gray",
"res://modules/world_map/assets/": "blue",
"res://modules/world_map/scripts/": "teal",
"res://tests/": "red"
}

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2

[sim]

battle_sim=true

[debug]
; GDScript 静态分析风格类警告降档（默认 Warn → Ignore）：项目数百脚本历史风格不一，
; 未用参数/遮蔽/整除取整等均为风格提示非缺陷（真实错误=Error 级不受影响，照常显示）。
; 2026-09-27 创始人批准清理「问题面板 200+ 存量」时定档。
gdscript/warnings/unused_signal=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/redundant_await=0
