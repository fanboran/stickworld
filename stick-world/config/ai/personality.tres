[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/balance/balance_resource.gd" id="1"]

[resource]
script = ExtResource("1")
resource_name = "personality"
_meta = {
	"resource_name": "personality",
	"version": "0.2.0",
	"description": "AI personality 难度档案（A1 · C2 + A2 · C3/C4/C5 + A3 · C6 + A4 · C7，设计文档12号）。手写平衡资源（非 Excel 导出管线背书），BalanceConfig 统一装载（类型路径 ai.personality）与热重载。global 行 = L4 层基础节拍 + 任务槽内核参数（C3 槽超时 / C4 四因子评分权重，CoH 真值）+ default_behavior v2 效用打分参数（C7：default_behavior_v2_enabled 开关默认关 = 零回归门，demand_increment=±分基准 CoH 50，方差扰动单旋钮 demand_variance 走难度行）；easy/standard/hard/hardest 行 = 难度档覆盖参数（standard 行 = 代码默认档案的配置化镜像）；retreat_chance = A3 概率调制撤退掷骰（L1 个体层消费，ai.behavior_profiles 基线值兜底）。全部数值语义推断初值，待实测校准。",
	"category": "ai"
}
variables = {
	"data": [
		{
			"id": "global",
			"beat_interval": 0.5,
			"slot_kernel_enabled": true,
			"score_threat": 5.0,
			"score_avoid_clumps_at_no_threat": 10.0,
			"score_distance_to_squad": 5.0,
			"score_distance_to_base": 5.0,
			"score_inertia": 1.4,
			"score_threat_radius": 260.0,
			"score_clump_radius": 300.0,
			"score_distance_norm": 1200.0,
			"score_inertia_tolerance": 120.0,
			"attack_rally_timeout": 180.0,
			"attack_target_timeout": 30.0,
			"defend_target_timeout": 120.0,
			"defend_rally_timeout": 240.0,
			"base_threat_threshold": 5.0,
			"base_threat_floor": 5.0,
			"vp_rule_enabled": false,
			"default_behavior_v2_enabled": false,
			"demand_increment": 50.0,
			"description": "L4 阵营 AI 全局行：beat_interval=C1 基础节拍（CoH 0.5s 真值）；slot_kernel_enabled=决策内核开关（false 退化 SWL 比例条件，咬合③）；score_* = C4 目标评分四因子权重（CoH 真值 5/10/5/5/1.4）与取数半径/归一尺度；attack/defend_*_timeout = C3 槽集结/目标超时（CoH 3min/30s/2min）；base_threat_*=C5 基地威胁封顶（0-100 口径，CoH 5/5）；vp_rule_enabled=C5 规则一胜利目标危急（开放问题#1 无 VP 等价物，缺省关闭【提案/待定】）；default_behavior_v2_enabled=C7 效用打分选择器开关（消费组织 default_behavior 字段，缺省关闭=零回归门）；demand_increment=C7 ±分基准（命中 +N 未命中 -N，CoH s_demand_increment=50 真值）；方差扰动单旋钮 demand_variance 在难度行（收敛红线·咬合④）"
		},
		{
			"id": "easy",
			"seconds_before_attack": 20.0,
			"start_attack_variance": 8.0,
			"demand_variance": 0.8,
			"attack_pct_baseline": 0.5,
			"attack_pct_growth_per_min": 0.01,
			"max_attack_percentage": 0.6,
			"superiority_ratio_floor": 0.4,
			"superiority_gain": 0.0,
			"retreat_chance": 0.30,
			"description": "简单档：开局攻击晚且随机窗宽；攻击百分比基调低且封顶低、不吃军力优势递增（CoH 递增仅 hard/hardest 消费同构）；demand_variance=方差扰动单旋钮；retreat_chance=撤退掷骰概率（CoH easy 0.30 真值）"
		},
		{
			"id": "standard",
			"seconds_before_attack": 10.0,
			"start_attack_variance": 2.0,
			"demand_variance": 0.8,
			"attack_pct_baseline": 0.6,
			"attack_pct_growth_per_min": 0.01,
			"max_attack_percentage": 0.70,
			"superiority_ratio_floor": 0.4,
			"superiority_gain": 1.0,
			"retreat_chance": 0.30,
			"description": "标准档：与 team_ai_profiles.DEFAULTS 代码默认一致（P6 语义推断初值 + A2 CoH 真值），保证零回归基线；retreat_chance=撤退掷骰概率（CoH standard 0.30 真值）"
		},
		{
			"id": "hard",
			"seconds_before_attack": 5.0,
			"start_attack_variance": 1.0,
			"demand_variance": 0.8,
			"attack_pct_baseline": 0.6,
			"attack_pct_growth_per_min": 0.01,
			"max_attack_percentage": 0.85,
			"superiority_ratio_floor": 0.4,
			"superiority_gain": 1.25,
			"retreat_chance": 0.45,
			"description": "困难档：开局攻击更早更果断；攻击百分比封顶抬高+军力优势递增增益（CoH hard/hardest 递增同构）；retreat_chance=撤退掷骰概率（CoH hard 0.45 真值，越难越会审时撤退）"
		},
		{
			"id": "hardest",
			"seconds_before_attack": 3.0,
			"start_attack_variance": 0.5,
			"demand_variance": 0.8,
			"attack_pct_baseline": 0.7,
			"attack_pct_growth_per_min": 0.01,
			"max_attack_percentage": 0.95,
			"superiority_ratio_floor": 0.4,
			"superiority_gain": 1.5,
			"retreat_chance": 0.35,
			"description": "极难档：开局攻击最短+攻击百分比封顶最高+递增增益最大；难度差异全在时机/方差/比例参数，不送资源不改数值（C2 铁律）；retreat_chance=撤退掷骰概率（CoH hardest 0.35 真值，比 hard 低——最难题设更疯）"
		}
	]
}
