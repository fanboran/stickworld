class_name StickTokens
extends RefCounted
## UI 设计 Token —— 全套视觉常量唯一真相源（颜色/字号/间距/形状/时长）。
##
## 设计语言：双表面体系（前端玻璃拟态）：
##   - **深色面**（全局默认）：HUD / 主菜单 / 加载画面 / 游戏内常驻 UI —— 深色玻璃 + 浅色文字，
##     保证亮世界背景下可读（火柴人黑沥青世界观延续）。
##   - **浅色面**（白色磨砂面板）：弹窗/确认框/建造列表/资源条 —— 高透白 + 柔和投影（不描边），
##     子树挂 StickTheme.create_light_surface() 取 TEXT_ON_LIGHT 深色文字。
##   - 按钮一律深色磨砂玻璃（两种表面都成立，白面板上是"白卡深玻按钮"前端经典配）。
## 琥珀暖色（火光）作唯一强调色。详见 docs/设计/UI/01-设计语言.md。
##
## 换肤 = 改这一个文件；StickStyle / StickTheme 全部从这里取值，不写死字面量。

# ─────────────────────────────── 色彩 · 基底 ────────────────────────────────

## 主窗体底（大面板/弹窗）：白色磨砂，高不透明透一点画面
const WINDOW_BG := Color(0.965, 0.97, 0.985, 0.9)
## 次窗体底（HUD 横条/内嵌区块）：深色玻璃（更透，"黑玻璃窗"）
const WINDOW_BG_LIGHT := Color(0.02, 0.024, 0.034, 0.72)
## 全屏模态遮罩（压暗游戏画面，生成艺术背景叠加其上）
const MODAL_DIM := Color(0.02, 0.03, 0.06, 0.55)
## 输入框/凹槽底：深色凹槽（浅色面上仍是深色槽，保持可辨）
const GROOVE_BG := Color(0.0, 0.0, 0.0, 0.45)

# ─────────────────────────────── 色彩 · 描边 ────────────────────────────────

## 常规描边：白色低透明（深色玻璃按钮的边缘光）
const BORDER := Color(1.0, 1.0, 1.0, 0.16)
## 强描边（悬停/聚焦/主按钮）
const BORDER_STRONG := Color(1.0, 1.0, 1.0, 0.38)

# ─────────────────────────────── 色彩 · 文字（深色面默认）────────────────────────────────

const TEXT := Color(0.93, 0.94, 0.96)
const TEXT_DIM := Color(0.93, 0.94, 0.96, 0.55)
const TEXT_FAINT := Color(0.93, 0.94, 0.96, 0.32)
const TEXT_DISABLED := Color(0.93, 0.94, 0.96, 0.25)

# ─────────────────────────────── 色彩 · 文字（白色磨砂面板上）────────────────────────────────

## 浅色面（白面板子树）专用：StickTheme.create_light_surface() 里应用
const TEXT_ON_LIGHT := Color(0.17, 0.18, 0.23)
const TEXT_ON_LIGHT_DIM := Color(0.17, 0.18, 0.23, 0.6)
const TEXT_ON_LIGHT_FAINT := Color(0.17, 0.18, 0.23, 0.38)
const TEXT_ON_LIGHT_DISABLED := Color(0.17, 0.18, 0.23, 0.26)

# ─────────────────────────────── 色彩 · 语义 ────────────────────────────────

## 强调色：琥珀火光。主按钮/选中态/激活标签/关键数值
const ACCENT := Color(0.95, 0.68, 0.25)
const ACCENT_BG := Color(0.95, 0.68, 0.25, 0.14)
const ACCENT_TEXT := Color(0.1, 0.08, 0.04)
## 危险/删除/战败
const DANGER := Color(0.9, 0.34, 0.3)
const DANGER_BG := Color(0.9, 0.34, 0.3, 0.14)
## 成功/增益/完工
const SUCCESS := Color(0.45, 0.8, 0.48)
## 信息/通知/链接
const INFO := Color(0.55, 0.78, 1.0)
## 警告/不足
const WARN := Color(0.98, 0.82, 0.3)

# ─────────────────────────────── 色彩 · 按钮态（深色磨砂玻璃，两种表面通用）────────────────────────────────

const BTN_BG := Color(0.08, 0.1, 0.14, 0.5)
const BTN_BG_HOVER := Color(0.12, 0.15, 0.2, 0.72)
const BTN_BG_PRESSED := Color(0.05, 0.06, 0.09, 0.65)
const BTN_BG_DISABLED := Color(0.55, 0.58, 0.65, 0.2)

# ─────────────────────────────── 字号 ────────────────────────────────

## 主菜单游戏名/全屏大标题
