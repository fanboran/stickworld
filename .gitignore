node_modules/sticknodes-js/sticknodes_js.js

tools/mocap/references/

# Godot 自定义用户数据目录（--user-data-dir 调试残留，不入库）
stick-world/Godot/

# freebuff 工具本地产物
.freebuff/

# git worktree（F:\VSCode\game-2\.worktrees\ 与 .temp\ 下的多分支工作区，不入库）
.worktrees/
.temp/
# 音乐管线的中间产物（分轨 WAV / 母带 WAV / MIDI / 报告，体积极大）
# 交付件在 stick-world/assets/audio/bgm/ 与 ambience/，那些要进版本库
tools/music/out/

# 导出构建产物（export/ 下的说明文档仍入库，只忽略二进制产物）
export/**/*.exe
export/**/*.pck
export/**/*.dll
export/**/*.zip

# 诊断截图等临时产物（不入库）
temp/
external/swl_apk/
.tmp_shots/
docs/.obsidian/

.trae/
简历*.md
面试*
# tests/dev 顶层渲染输出图（diag/探针脚本每次运行重生成，不入库；proto_hd2d 等子目录输入贴图不受影响）
stick-world/tests/dev/*.png
stick-world/tests/dev/*.jpg
