[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/balance/balance_resource.gd" id="1"]

[resource]
script = ExtResource("1")
resource_name = "behavior_profiles"
_meta = {
	"resource_name": "behavior_profiles",
	"version": "0.1.0",
	"description": "R2 兵种人格覆盖档（A9 · 设计文档12号 §2.2 RWR 登记表）：个体 AI 参数的运行时可调层。合并序 = 代码基线（behavior_profiles.BASELINE）← 代码兵种覆盖（CLASS_PROFILES，SWL 直译真值宿主）← 本表行（baseline 行 + 兵种行，同 id 后行覆盖前行，行只写差异项 = RWR 职业文件语义）。本表 baseline 行镜像 A9 新键组代码默认（零回归基线）；调参先改这里（F9 热重载），兵种行按需补。全部数值语义推断初值，待实测校准。",
	"category": "ai"
}
variables = {
	"data": [
		{
			"id": "baseline",
			"decision_interval": 0.3,
			"decision_variance": 0.1,
			"rout_strafe_enabled": true,
			"heal_buzz_distance": 60.0,
			"suppression_enabled": false,
			"stuck_watchdog_enabled": false,
			"suppression_near_miss_enabled": false,
			"spawn_jitter_enabled": true,
			"spawn_jitter_ratio": 0.5,
			"probe_fail_cooldown_enabled": true,
			"job_scan_interval": 0.5,
			"suppression_near_miss_radius": 45.0,
			"description": "R1 主决策间隔 0.3s ± 0.1 方差（逐拍重掷去同步）；R5 防扎堆治疗 60px（RWR consider_someone_already_healing_wounded_distance 10m 同构换算）；A6 近失半径 45px（停战治理收窄：80px 在 45px 密度战线上=箭雨钉住全场，贴命中判定 34 待实测校准）；压制总门+近失门关（裁决#31 战场关闸）、卡死看门狗关（街道导航用，战场误判乱推源）；GK-3 开闸：出生错峰 + 域级失败冷却两键翻 true（读档相位回填走 ai_timing 存档链）；犹豫/点射/夜间犹豫键随裁决#31-#32 退役（SWL/SW3 dump 无此机制，残留键清除）"
		},
		{
			"id": "staff",
			"kite_range": 480.0,
			"description": "灵动性开闸：法师保距（施法射程 600>480 无死锁；锚点弓手 500 档下浮，待实测校准）"
		}
	]
}
