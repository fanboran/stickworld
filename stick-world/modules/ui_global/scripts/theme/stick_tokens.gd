class_name StickTokens
extends RefCounted
## UI 设计 Token —— 全套视觉常量唯一真相源（颜色/字号/间距/形状/时长）。
##
## 设计语言：「白色磨砂玻璃」——高透白面板 + 柔和投影，画面透出来（前端常见质感），
## 面板不描边（白底 + 阴影造深度），琥珀暖色（火光）作唯一强调色。
## 详见 docs/设计/UI/01-设计语言.md。
##
## 换肤 = 改这一个文件；StickStyle / StickTheme 全部从这里取值，不写死字面量。

# ─────────────────────────────── 色彩 · 基底 ────────────────────────────────

## 主窗体底（大面板/弹窗）：白色磨砂，高不透明透一点画面
const WINDOW_BG := Color(0.965, 0.97, 0.985, 0.9)
## 次窗体底（HUD 横条/内嵌区块）：更透的"白色玻璃"
const WINDOW_BG_LIGHT := Color(1.0, 1.0, 1.0, 0.5)
## 全屏模态遮罩（压暗游戏画面，生成艺术背景叠加其上）
const MODAL_DIM := Color(0.02, 0.03, 0.06, 0.55)
## 输入框/凹槽底（白底浅灰凹槽）
const GROOVE_BG := Color(0.88, 0.9, 0.94, 0.55)

# ─────────────────────────────── 色彩 · 描边 ────────────────────────────────

## 常规描边：面板无描边（透明）——白底靠阴影/透明度差分层，不靠边框线
const BORDER := Color(1.0, 1.0, 1.0, 0.0)
## 强描边（悬停/聚焦/主按钮）：柔和蓝灰，白底上仍可辨
const BORDER_STRONG := Color(0.42, 0.48, 0.62, 0.38)

# ─────────────────────────────── 色彩 · 文字 ────────────────────────────────

const TEXT := Color(0.17, 0.18, 0.23)
const TEXT_DIM := Color(0.17, 0.18, 0.23, 0.6)
const TEXT_FAINT := Color(0.17, 0.18, 0.23, 0.38)
const TEXT_DISABLED := Color(0.17, 0.18, 0.23, 0.26)

# ─────────────────────────────── 色彩 · 语义 ────────────────────────────────

## 强调色：琥珀火光。主按钮/选中态/激活标签/关键数值
const ACCENT := Color(0.95, 0.68, 0.25)
const ACCENT_BG := Color(0.95, 0.68, 0.25, 0.14)
const ACCENT_TEXT := Color(0.1, 0.08, 0.04)
## 危险/删除/战败
const DANGER := Color(0.9, 0.34, 0.3)
const DANGER_BG := Color(0.9, 0.34, 0.3, 0.14)
## 成功/增益/完工
const SUCCESS := Color(0.45, 0.8, 0.48)
## 信息/通知/链接
const INFO := Color(0.55, 0.78, 1.0)
## 警告/不足
const WARN := Color(0.98, 0.82, 0.3)

# ─────────────────────────────── 色彩 · 按钮态 ────────────────────────────────

const BTN_BG := Color(1.0, 1.0, 1.0, 0.45)
const BTN_BG_HOVER := Color(1.0, 1.0, 1.0, 0.75)
const BTN_BG_PRESSED := Color(0.85, 0.88, 0.94, 0.65)
const BTN_BG_DISABLED := Color(1.0, 1.0, 1.0, 0.2)

# ─────────────────────────────── 字号 ────────────────────────────────

## 主菜单游戏名/全屏大标题
const FONT_DISPLAY := 34
## 面板大标题
const FONT_TITLE := 22
## 正文/按钮
const FONT_BODY := 14
## 区块小标题（全大写感/分节）
const FONT_SECTION := 13
## 提示/辅助
const FONT_HINT := 11
## 角标/徽标/极密列表
const FONT_TINY := 10

# ─────────────────────────────── 形状 ────────────────────────────────

## 通用圆角（小，圆润感）
const RADIUS := 4
## 大面板圆角（更圆润，磨砂质感）
const RADIUS_PANEL := 10
## 描边宽度
const BORDER_W := 1
## 控件内边距（左右）
const PAD_X := 12
## 控件内边距（上下）
const PAD_Y := 6
## 面板投影（柔和大阴影造深度，替代描边）
const PANEL_SHADOW_SIZE := 18.0
const PANEL_SHADOW_OFFSET := Vector2(0, 8)

# ─────────────────────────────── 控件尺寸 ────────────────────────────────

const BTN_H := 32.0
const BTN_H_SM := 26.0
const BTN_H_LG := 44.0
## 菜单/设置行高
const ROW_H := 36.0

# ─────────────────────────────── 布局约束 ────────────────────────────────

## 屏幕安全边距：任何浮层/HUD 部件离屏幕边缘的最小距离（通栏条除外）。
## 贴边摆放是布局事故的高发区，一律经 StickKit.dock() 落位，不手写 offset。
const SCREEN_MARGIN := 12.0
## 弹窗最小四周留白（弹窗不得铺满全屏）
const MODAL_MARGIN := 48.0

# ─────────────────────────────── 动效时长（秒）────────────────────────────────

## 悬停/渐隐渐显
const T_FADE := 0.12
## 面板开合
const T_PANEL := 0.18
## Toast 停留
const T_TOAST := 3.0
