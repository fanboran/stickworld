[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/balance/balance_resource.gd" id="1"]

[resource]
script = ExtResource("1")
resource_name = "territories"
_meta = {
	"resource_name": "territories",
	"version": "0.1.0",
	"description": "领地（敌据点）配置。字段规范见 docs/技术/架构/出征与领地架构.md §2.1；首版手写，数值定稿后迁 config/excel/扩张数据.xlsx territories sheet 重导出",
	"category": "handwritten",
	"source": "handwritten",
	"ai_proposal": "据点命名/守军编成/奖励数值与解锁内容/撤仗阈值均为 AI 提案，实测定稿",
	"field_notes": {
		"garrison[].profile": "兵种档案 = config/units/stickmen.tres 的单位 id（GarrisonSpawner 按 id 经 UnitsApi 刷出）",
		"garrison[].tier": "战术档位 = config/combat/tactics.tres 的战术 id",
		"commander.retreat_thresholds": "敌将撤仗评估阈值：casualty_rate 伤亡率 / loss_ratio 战损比 / timeout 相持秒数",
		"name_zh": "据点名用通用描述性称谓（现代直白，直接叫它的样子/功能），禁武侠式雅名——命名口径见 docs/设计/命名与数值口径.md",
		"rewards.resources": "奖励数值按策划常识取自然数、量级克制（不追求整十——清一色整十会显假）——数值口径见 docs/设计/命名与数值口径.md",
		"rewards.unlocks": "占领解锁项 id → 写入 WorldState.unlocks 台账，消费端自听 EventBus.unlock_granted 生效（现为建筑可建集门禁：id 须与 config/buildings/buildings.tres 的 unlocked_by_tech 对齐，展示名见 modules/expansion/api.gd 的 UNLOCK_LABELS）",
		"entry_side": "玩家进入方位（守军布阵参考）：0=西（左）",
		"settlement_key": "L1 世界包聚落 id（settlement.settlement_id），占领后染色目标",
		"tile_key": "所属地块 id（tile_id），region_owner_changed 发此级 id（架构 §9.1）"
	}
}
