[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/balance/balance_resource.gd" id="1"]

[resource]
script = ExtResource("1")
resource_name = "personality"
_meta = {
	"resource_name": "personality",
	"version": "0.1.0",
	"description": "AI personality 难度档案（A1 · 设计文档12号 C2）：难度=参数不=作弊。手写平衡资源（非 Excel 导出管线背书），BalanceConfig 统一装载（类型路径 ai.personality）与热重载。global 行 = L4 层基础节拍（C1 收敛红线：每层一个基础节拍）；easy/hard/hardest 行 = 难度档覆盖参数（standard 行 = 代码默认档案的配置化镜像）。全部数值语义推断初值，待实测校准。",
	"category": "ai"
}
variables = {
	"data": [
		{
			"id": "global",
			"beat_interval": 0.5,
			"description": "L4 阵营 AI 基础节拍（s）——CoH 真值 TimeRule_AddInterval(fn, 0.5)，决策不逐帧思考；行为级偏移由 team_ai 相位轮转表达（0.5s 一跳一类事）"
		},
		{
			"id": "easy",
			"seconds_before_attack": 20.0,
			"start_attack_variance": 8.0,
			"demand_variance": 0.8,
			"description": "简单档：开局攻击时间晚且随机窗宽（CoH start_attack_time 9min±4min 同构）；demand_variance=方差扰动单旋钮（收敛红线，A4 效用打分消费）"
		},
		{
			"id": "standard",
			"seconds_before_attack": 10.0,
			"start_attack_variance": 2.0,
			"demand_variance": 0.8,
			"description": "标准档：与 team_ai_profiles.DEFAULTS 代码默认一致（P6 语义推断初值），保证零回归基线"
		},
		{
			"id": "hard",
			"seconds_before_attack": 5.0,
			"start_attack_variance": 1.0,
			"demand_variance": 0.8,
			"description": "困难档：开局攻击更早更果断"
		},
		{
			"id": "hardest",
			"seconds_before_attack": 3.0,
			"start_attack_variance": 0.5,
			"demand_variance": 0.8,
			"description": "极难档：开局攻击时间最短；难度差异全在时机/方差参数，不送资源不改数值（C2 铁律）"
		}
	]
}
